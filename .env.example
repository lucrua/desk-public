# ─── Database ────────────────────────────────────────────────────────────────

# Main database (required). Postgres 16 connection string.
# Local dev: points at the Docker container started by docker-compose.dev.yml.
DATABASE_URL=postgres://hub:hub@127.0.0.1:5433/hub

# Test database (required for `pnpm vitest run`). Keep isolated from dev/prod.
TEST_DATABASE_URL=postgres://hub:hub@127.0.0.1:5433/hub_test

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Identity provider (required).
#   dev         — role-switcher UI, no real auth. Safe for local development.
#                 The app refuses to start with AUTH_MODE=dev in NODE_ENV=production.
#   cloudflare  — Cloudflare Access JWT verification. Required for production.
AUTH_MODE=dev

# Transitional backfill (OPTIONAL — upgrade aid only, not required for new deploys).
# If set at app boot, the server idempotently promotes that email's user to
# role='admin' (preserves your admin when upgrading from admin-model v1 to v2,
# where role derivation moved from ADMIN_EMAIL → the stored role column).
# On a fresh deployment: leave unset — the first CF-verified email sign-in
# automatically becomes admin (first-login bootstrap).
# Remove this env var after the first post-upgrade deploy confirms your admin
# account still has access to /admin.
# ADMIN_EMAIL=admin@example.com

# ─── URLs ─────────────────────────────────────────────────────────────────────

# Absolute base URL of the operator host (desk.<domain>), no trailing slash.
# Used for absolute URL generation in API responses.
HUB_BASE_URL=http://localhost:3000

# Absolute base URL of the share host (share.<domain>), no trailing slash.
# Used when minting capability share link URLs.
SHARE_BASE_URL=http://localhost:3000

# ─── Share host guard (production only) ──────────────────────────────────────

# Bare hostname of the share host, no scheme or port (e.g. share.example.com).
# When set, the middleware blocks all paths except /s/*, /_next/*, and
# /robots.txt on this hostname, returning HTTP 404. Leave unset in dev —
# the middleware becomes a no-op.
# SHARE_HOST=share.example.com

# ─── Cloudflare Access (production only, AUTH_MODE=cloudflare) ───────────────

# Your CF Access team domain.
# Find it: Cloudflare Zero Trust → Settings → Team Domain.
# CF_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Audience tag for the desk.<domain> Access application.
# Find it: CF Zero Trust → Access → Applications → your app → Overview → Application Audience.
# CF_AUD=
